# ===========================================================================
# Organizaí — variáveis de ambiente
#
# Copie para `.env` em desenvolvimento. Em produção (Easypanel), cadastre cada
# uma na aba Environment do serviço.
# ===========================================================================

# --- Banco de dados --------------------------------------------------------
# PostgreSQL. Formato:
#   postgres://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?sslmode=...
DATABASE_URL="postgres://usuario:senha@host:5432/organizai?sslmode=disable"
#
# Se o app roda no MESMO servidor Easypanel que o banco, prefira o host interno
# do serviço (ex.: `meu-projeto_postgres`) em vez do domínio público: o tráfego
# não sai da máquina, fica mais rápido e não trafega senha pela internet.
#
# `sslmode=disable` só é aceitável em rede interna. Em conexão pela internet,
# use `sslmode=require` se o servidor suportar.


# --- Sessão ----------------------------------------------------------------
SESSION_COOKIE_NAME="organizai_session"
# Dias de validade da sessão. Ela se renova sozinha enquanto houver uso.
SESSION_TTL_DAYS="30"


# --- Notificações push (Web Push / VAPID) ----------------------------------
# Gere um par novo para produção com:  npm run push:keys
#
# ATENÇÃO: NEXT_PUBLIC_VAPID_PUBLIC_KEY é embutida no JavaScript do navegador
# durante o BUILD. No Easypanel ela precisa estar cadastrada antes de construir
# a imagem — informá-la só em tempo de execução não funciona.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@seudominio.com"


# --- Lembretes -------------------------------------------------------------
# Liga o agendador interno (um tique por minuto dentro do próprio servidor).
# Mantenha "true" no Easypanel, que roda um container permanente.
ENABLE_REMINDER_SCHEDULER="true"
# Segredo do endpoint POST /api/notifications/tick. Gere um valor aleatório.
CRON_SECRET=""


# --- Conta de administrador (opcional) -------------------------------------
# Se preenchidas, a conta é criada na primeira subida. Se já existir, nada muda
# e a senha NÃO é sobrescrita.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"
