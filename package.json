{
  "name": "organizai",
  "version": "0.1.0",
  "private": true,
  "description": "Organizaí — Organize. Simplifique. Faça acontecer.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "db:migrate-priorities": "node --experimental-strip-types prisma/migrate-priorities.ts",
    "db:create-admin": "node --experimental-strip-types prisma/create-admin.ts",
    "db:migrate": "prisma migrate deploy",
    "push:keys": "node -e \"const w=require('web-push');const k=w.generateVAPIDKeys();console.log('NEXT_PUBLIC_VAPID_PUBLIC_KEY=\\\"'+k.publicKey+'\\\"');console.log('VAPID_PRIVATE_KEY=\\\"'+k.privateKey+'\\\"')\"",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/client": "6.19.3",
    "lucide-react": "0.577.0",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/web-push": "^3.6.4",
    "eslint": "9.21.0",
    "eslint-config-next": "15.5.25",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
