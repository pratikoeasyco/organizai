{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // O seed roda fora do bundler do Next (node --experimental-strip-types) e usa
  // import com extensão .ts, incompatível com estas opções de compilação.
  "exclude": [
    "node_modules",
    "prisma/seed.ts",
    "prisma/migrate-priorities.ts",
    "prisma/create-admin.ts"
  ]
}
